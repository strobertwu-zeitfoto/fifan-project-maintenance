{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fifan read-only archive coverage request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "items"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "allowed_external_roots": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "archive"
        ],
        "properties": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "selector"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "selector": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "value"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "heading",
                          "snippet"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "start_byte",
                      "end_byte"
                    ],
                    "properties": {
                      "kind": {
                        "const": "bytes"
                      },
                      "start_byte": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "end_byte": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "table"
                      },
                      "index": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "heading": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "not": {
                      "required": [
                        "index",
                        "value"
                      ]
                    }
                  }
                ]
              },
              "expected_sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "root": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "archive": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "selector",
              "reference_base",
              "classification_basis"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "selector": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "value"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "heading",
                          "snippet"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "start_byte",
                      "end_byte"
                    ],
                    "properties": {
                      "kind": {
                        "const": "bytes"
                      },
                      "start_byte": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "end_byte": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "table"
                      },
                      "index": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "heading": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "not": {
                      "required": [
                        "index",
                        "value"
                      ]
                    }
                  }
                ]
              },
              "expected_sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "root": {
                "type": "string",
                "minLength": 1
              },
              "reference_base": {
                "type": "string",
                "minLength": 1
              },
              "classification_basis": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "description": "Runtime checks at most min(100,max_files) items and reports unchecked work. Each external endpoint root must be explicitly allowed. Selection compares exact UTF-8 bytes; no originals are emitted."
}
