{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fifan explicit measurement request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "active": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "start_line",
          "end_line",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "const": "current"
          }
        }
      }
    },
    "reused_archives": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root",
              "path"
            ],
            "properties": {
              "root": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "new_archives": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root",
              "path"
            ],
            "properties": {
              "root": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "external_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "external_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "path"
        ],
        "properties": {
          "root": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "baseline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes",
          "collected_at",
          "source"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "collected_at": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "allow_absent": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "path"
        ],
        "properties": {
          "role": {
            "enum": [
              "active",
              "reused_archives",
              "new_archives",
              "external_records"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "Each entry must match an exact declared file in the same role; external root must be explicitly allowed. Only FD-confirmed FileNotFound with successful authorization is a known zero. Does not permit deletion or apply to views."
    }
  },
  "description": "Omitted role domains are Unknown; explicit [] means known empty. Exact files only, canonical authorized external roots must not overlap the project. Views count separately from storage. Runtime validates bounds, source identity and shared budgets."
}
