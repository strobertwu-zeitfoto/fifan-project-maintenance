{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fifan operations request v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "operations"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "path",
              "new"
            ],
            "properties": {
              "type": {
                "const": "replace"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "old": {
                "type": "string",
                "minLength": 1
              },
              "new": {
                "type": "string"
              },
              "old_locator": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sha256",
                  "start_byte",
                  "end_byte"
                ],
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "start_byte": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end_byte": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "oneOf": [
              {
                "required": [
                  "old"
                ]
              },
              {
                "required": [
                  "old_locator"
                ]
              }
            ],
            "description": "old_locator is preview CLI input sugar only; CLI binds raw UTF-8 bytes and expands to standard old. Python changes.preview accepts old, not old_locator."
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "path",
              "destination"
            ],
            "properties": {
              "type": {
                "const": "move"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "destination": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "path",
              "destination",
              "expected_sha256",
              "origin"
            ],
            "properties": {
              "kind": {
                "const": "snapshot"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "destination": {
                "type": "string",
                "minLength": 1
              },
              "expected_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "origin": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reference_base",
                  "classification_basis"
                ],
                "properties": {
                  "reference_base": {
                    "type": "string",
                    "minLength": 1
                  },
                  "classification_basis": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        ]
      }
    },
    "guards": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "value"
        ],
        "properties": {
          "kind": {
            "enum": [
              "snippet",
              "heading",
              "table",
              "anchor"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "exceptions": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "old",
                "new"
              ],
              "properties": {
                "old": {
                  "type": "string",
                  "minLength": 1
                },
                "new": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "description": "Runtime also verifies source fingerprints, nonoverlapping writes, source-before-snapshot dependency, unique matching and exact guard preservation. This is not an authorization token."
}
