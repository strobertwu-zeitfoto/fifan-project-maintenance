{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fifan task profile v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "reference_bodies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "historical_roots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "max_findings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "start_line",
          "end_line",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "current",
              "historical"
            ]
          }
        }
      }
    },
    "goal": {
      "oneOf": [
        {
          "enum": [
            "navigation",
            "body-slim",
            "storage"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "navigation",
                "body-slim",
                "storage"
              ]
            },
            "each_file": {
              "type": "boolean"
            },
            "max_after_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "minimum_reduction_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "exceptions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "reason"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "measurement": {
      "$ref": "measurement-request.schema.json"
    },
    "history_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "max_output_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "per_root_max_files": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          }
        }
      }
    },
    "parent_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "parent_profile_sha256",
        "parent_scope_sha256"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "parent_profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parent_scope_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "description": "Versioned extension of schema1. Source subsets, view bounds, parent roots and per-root history budget keys are additionally validated against actual project/task declarations. Schema1 remains unchanged."
}
