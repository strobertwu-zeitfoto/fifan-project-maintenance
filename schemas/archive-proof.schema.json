{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fifan archive coverage proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "root",
    "config_sha256",
    "allowed_external_roots",
    "items",
    "proof_sha256"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "proof_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "allowed_external_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "archive",
          "reference_base_sha256",
          "classification_basis_sha256"
        ],
        "properties": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root",
              "path",
              "expected_sha256",
              "selector",
              "selected_sha256"
            ],
            "properties": {
              "root": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "expected_sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "selected_sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "selector": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "start_byte",
                  "end_byte"
                ],
                "properties": {
                  "kind": {
                    "const": "bytes"
                  },
                  "start_byte": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end_byte": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          "archive": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root",
              "path",
              "expected_sha256",
              "selector",
              "selected_sha256"
            ],
            "properties": {
              "root": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "expected_sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "selected_sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "selector": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "start_byte",
                  "end_byte"
                ],
                "properties": {
                  "kind": {
                    "const": "bytes"
                  },
                  "start_byte": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end_byte": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          "reference_base_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "classification_basis_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    }
  },
  "description": "Generated only from all-Exact coverage; fingerprint, endpoints, original bytes and context hashes are revalidated. External-root proofs are read-only and cannot be persisted into v2 execution guards."
}
