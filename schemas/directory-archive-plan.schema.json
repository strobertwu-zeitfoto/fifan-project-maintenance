{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fifan private same-volume directory archive plan schema1",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "kind",
    "project_root",
    "profile_sha256",
    "config_sha256",
    "roots",
    "operation_id",
    "fingerprint",
    "request_sha256",
    "request",
    "batches",
    "impact",
    "impact_material_sha256",
    "hash_usage"
  ],
  "properties": {
    "format": {
      "const": "fifan-directory-plan"
    },
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "directory-archive"
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "roots": {
      "type": "object",
      "required": [
        "project",
        "archive",
        "records"
      ],
      "properties": {
        "project": {
          "type": "object",
          "required": [
            "path",
            "device",
            "inode"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "device": {
              "type": "integer"
            },
            "inode": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "archive": {
          "type": "object",
          "required": [
            "path",
            "device",
            "inode"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "device": {
              "type": "integer"
            },
            "inode": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "records": {
          "type": "object",
          "required": [
            "path",
            "device",
            "inode"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "device": {
              "type": "integer"
            },
            "inode": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request": {
      "$ref": "directory-request.schema.json"
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "source",
          "destination",
          "manifest",
          "known_absent",
          "open_handles",
          "locator_text",
          "locator_sha256"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "destination": {
            "type": "string",
            "minLength": 1
          },
          "manifest": {
            "type": "object",
            "required": [
              "entries",
              "file_count",
              "directory_count",
              "file_bytes",
              "attributes_verified",
              "attributes_not_verified"
            ],
            "properties": {
              "entries": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "kind",
                    "mode",
                    "mtime_ns",
                    "device",
                    "inode"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "enum": [
                        "file",
                        "directory"
                      ]
                    },
                    "mode": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4095
                    },
                    "mtime_ns": {
                      "type": "integer"
                    },
                    "device": {
                      "type": "integer"
                    },
                    "inode": {
                      "type": "integer"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "nlink": {
                      "const": 1
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "file"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "bytes",
                          "sha256",
                          "nlink"
                        ]
                      }
                    }
                  ],
                  "additionalProperties": true
                }
              },
              "file_count": {
                "type": "integer",
                "minimum": 0
              },
              "directory_count": {
                "type": "integer",
                "minimum": 1
              },
              "file_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "attributes_verified": {
                "const": [
                  "mode",
                  "mtime_ns"
                ]
              },
              "attributes_not_verified": {
                "const": [
                  "ACL",
                  "xattr",
                  "physical_allocation"
                ]
              }
            },
            "additionalProperties": true
          },
          "known_absent": {
            "type": "array"
          },
          "open_handles": {
            "type": "object"
          },
          "locator_text": {
            "type": "string"
          },
          "locator_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": true
      }
    },
    "impact": {
      "type": "object"
    },
    "impact_material_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash_usage": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "PRIVATE unredacted 0600 material. Runtime archive/records grants must match the profile and all root identities; plan paths never authorize writes. Manifest bytes/permissions/mtime are verified, not ACL/xattr/physical allocation."
}
