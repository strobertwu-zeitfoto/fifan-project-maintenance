{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fifan explicit ordered session manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "root",
    "journals"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "journals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        ]
      }
    },
    "reports": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        ]
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "root"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "root": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  },
  "description": "Canonical absolute external references only; runtime checks project binding, journal location, SHA, chain and ownership. Standard profiles require a {path,root,sha256?} wrapper matching the real project; profiles alone do not expand permission. Journal order is explicit, never inferred from mtime."
}
