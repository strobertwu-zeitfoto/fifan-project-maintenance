{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fifan operations request v3 (compiled to v2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "operations"
  ],
  "properties": {
    "version": {
      "const": 3
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "path",
              "new"
            ],
            "properties": {
              "type": {
                "const": "replace"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "old": {
                "type": "string",
                "minLength": 1
              },
              "new": {
                "type": "string"
              },
              "old_locator": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sha256",
                  "start_byte",
                  "end_byte"
                ],
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "start_byte": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end_byte": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "oneOf": [
              {
                "required": [
                  "old"
                ]
              },
              {
                "required": [
                  "old_locator"
                ]
              }
            ],
            "description": "old_locator is preview CLI input sugar only; CLI binds raw UTF-8 bytes and expands to standard old. Python changes.preview accepts old, not old_locator."
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "path",
              "destination"
            ],
            "properties": {
              "type": {
                "const": "move"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "destination": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "path",
              "destination",
              "expected_sha256",
              "origin"
            ],
            "properties": {
              "kind": {
                "const": "snapshot"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "destination": {
                "type": "string",
                "minLength": 1
              },
              "expected_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "origin": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reference_base",
                  "classification_basis"
                ],
                "properties": {
                  "reference_base": {
                    "type": "string",
                    "minLength": 1
                  },
                  "classification_basis": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "path",
              "expected_sha256",
              "patches"
            ],
            "properties": {
              "type": {
                "const": "replace_many"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "expected_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "patches": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "new"
                  ],
                  "properties": {
                    "old": {
                      "type": "string",
                      "minLength": 1
                    },
                    "old_locator": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "sha256",
                        "start_byte",
                        "end_byte"
                      ],
                      "properties": {
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "start_byte": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "end_byte": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    },
                    "new": {
                      "type": "string"
                    }
                  },
                  "oneOf": [
                    {
                      "required": [
                        "old"
                      ]
                    },
                    {
                      "required": [
                        "old_locator"
                      ]
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "guards": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "value"
        ],
        "properties": {
          "kind": {
            "enum": [
              "snippet",
              "heading",
              "table",
              "anchor"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "exceptions": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "old",
                "new"
              ],
              "properties": {
                "old": {
                  "type": "string",
                  "minLength": 1
                },
                "new": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "archive_proofs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "archive-proof.schema.json"
      },
      "description": "Exact archive-coverage proof objects; revalidated and compiled into version2 guards. External-root proofs are not persistable in v2."
    }
  },
  "description": "Version3 is input syntax only. prepare_request returns an authoritative sealed v2 plan (or None for NoChange) and a text-free compilation receipt. Apply/overlay that plan or preview the original v3 request; do not re-preview prepared.request alone as an archive-proof artifact. Any invalid patch blocks the whole source file; total batch patches <=1000."
}
